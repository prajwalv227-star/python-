   "source": [
    "def palindrome(word):\n",
    "    if len(word) <= 1:\n",
    "        return True\n",
    "\n",
    "    if word[0] == word[-1]:\n",
    "        return palindrome(word[1:-1])\n",
    "    else:\n",
    "        return False\n",
    "\n",
    "text = input(\"Enter word: \")\n",
    "\n",
    "if palindrome(text):\n",
    "    print(\"Palindrome\")\n",
    "else:\n",
    "    print(\"Not a palindrome\")"
   ]
