    "def palindrome (text):\n",
    "    if text == text [::-1]:\n",
    "         print (\"palindrome \")\n",
    "    else :\n",
    "         print (\"not a palindrome \")\n",
    "\n",
    "word = input(\"enter a word \")\n",
    "palindrome (word)"
